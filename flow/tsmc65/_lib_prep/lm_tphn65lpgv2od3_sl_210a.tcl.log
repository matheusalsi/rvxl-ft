create_workspace lib_test -flow normal
set_app_options -name lib.workspace.allow_missing_related_pg_pins -value true
read_tech_file /home/gme/gustavo.platcheck/CI_EXPERT_II/iPDK/TSMC_digital_library/stclib/tcbn65gplus_200a/TSMCHOME/digital/Back_End/milkyway/tcbn65gplus_200a/techfiles/tsmcn65_9lmT2.tf
read_lef /home/gme/gustavo.platcheck/CI_EXPERT_II/iPDK/TSMC_digital_library/stclib/tphn65lpgv2od3_sl_210a/TSMCHOME/digital/Back_End/lef/tphn65lpgv2od3_sl_210a/mt_2/9lm/lef/tphn65lpgv2od3_sl_9lm.lef
foreach db [glob /home/gme/gustavo.platcheck/CI_EXPERT_II/iPDK/TSMC_digital_library/stclib/tphn65lpgv2od3_sl_210a/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tphn65lpgv2od3_sl_210a/*.db] {
	set fname [file tail $db]

	#Find all voltage patterns that indicate double voltage corners
	set volt_match [regexp -all -inline {d[0-9]} $fname]

	#If it has 2 or more voltage specifications, skip it
	if {[llength $volt_match] >=2} {
		echo "--> Skipping Double Voltage Corner: $fname"
		continue
	}
	
	echo "Reading .db file: $fname"
	read_db $db
}
check_workspace
commit_workspace -output tphn65lpgv2od3_sl_210a.ndm
exit
